generator client {
  provider = "prisma-client-js"
  binaryTargets = ["native", "debian-openssl-1.1.x", "debian-openssl-3.0.x"]
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model Role {
  id          String           @id @default(cuid())
  name        String           @unique
  description String?
  isSystem    Boolean          @default(false)
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt
  permissions RolePermission[]
  users       User[]
}

model Permission {
  id          String           @id @default(cuid())
  code        String           @unique
  module      String
  description String?
  roles       RolePermission[]
}

model RolePermission {
  id           String     @id @default(cuid())
  roleId       String
  permissionId String
  permission   Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)
  role         Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@unique([roleId, permissionId])
}

model User {
  id                     String             @id @default(cuid())
  username               String             @unique
  passwordHash           String
  fullName               String
  phone                  String?
  roleId                 String
  isActive               Boolean            @default(true)
  lastLoginAt            DateTime?
  createdAt              DateTime           @default(now())
  updatedAt              DateTime           @updatedAt
  auditLogs              AuditLog[]
  backups                Backup[]
  bkashTransactions      BkashTransaction[]
  cashTransactions       CashTransaction[]
  customerPayments       CustomerPayment[]
  dailyClosings          DailyClosing[]
  createdExpenses        Expense[]
  loginAttempts          LoginAttempt[]
  createdPurchases       Purchase[]         @relation("PurchaseCreatedBy")
  createdReturns         Return[]
  createdSalaries        Salary[]
  createdSales           Sale[]             @relation("SaleCreatedBy")
  codCollections         Sale[]             @relation("SaleCodCollectedBy")
  stockMovements         StockMovement[]
  supplierPayments       SupplierPayment[]
  createdSupplierReturns SupplierReturn[]   @relation("SupplierReturnCreatedBy")
  role                   Role               @relation(fields: [roleId], references: [id])
}

model LoginAttempt {
  id        String   @id @default(cuid())
  username  String
  success   Boolean
  userId    String?
  ipAddress String?
  createdAt DateTime @default(now())
  user      User?    @relation(fields: [userId], references: [id])

  @@index([username, createdAt])
}

model AuditLog {
  id            String   @id @default(cuid())
  userId        String?
  username      String
  role          String
  action        String
  module        String
  recordId      String?
  previousValue String?
  newValue      String?
  createdAt     DateTime @default(now())
  user          User?    @relation(fields: [userId], references: [id])

  @@index([module, recordId])
  @@index([createdAt])
}

model Category {
  id            String        @id @default(cuid())
  name          String        @unique
  description   String?
  isArchived    Boolean       @default(false)
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt
  products      Product[]
  subcategories Subcategory[]
}

model Subcategory {
  id         String    @id @default(cuid())
  categoryId String
  name       String
  isArchived Boolean   @default(false)
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt
  products   Product[]
  category   Category  @relation(fields: [categoryId], references: [id])

  @@unique([categoryId, name])
}

model Brand {
  id         String    @id @default(cuid())
  name       String    @unique
  isArchived Boolean   @default(false)
  products   Product[]
}

model Unit {
  id           String    @id @default(cuid())
  name         String    @unique
  abbreviation String
  isArchived   Boolean   @default(false)
  products     Product[]
}

model Product {
  id                String           @id @default(cuid())
  name              String
  imageUrl          String?
  categoryId        String
  subcategoryId     String?
  brandId           String?
  sku               String?          @unique
  barcode           String?          @unique
  unitId            String
  packSize          Decimal?
  expiryDate        DateTime?
  purchasePrice     Decimal          @default(0)
  sellingPrice      Decimal
  wholesalePrice    Decimal?
  minimumStock      Decimal          @default(0)
  currentStock      Decimal          @default(0)
  description       String?
  status            String           @default("ACTIVE")
  defaultSupplierId String?
  createdAt         DateTime         @default(now())
  updatedAt         DateTime         @updatedAt
  defaultSupplier   Supplier?        @relation(fields: [defaultSupplierId], references: [id])
  unit              Unit             @relation(fields: [unitId], references: [id])
  brand             Brand?           @relation(fields: [brandId], references: [id])
  subcategory       Subcategory?     @relation(fields: [subcategoryId], references: [id])
  category          Category         @relation(fields: [categoryId], references: [id])
  batches           ProductBatch[]
  purchaseItems     PurchaseItem[]
  returnItems       ReturnItem[]
  saleItems         SaleItem[]
  stockMovements    StockMovement[]
  supplierReturns   SupplierReturn[]

  @@index([name])
  @@index([status])
}

model ProductBatch {
  id                    String                     @id @default(cuid())
  productId             String
  supplierId            String?
  purchaseId            String?
  batchCode             String
  purchaseDate          DateTime                   @default(now())
  manufacturingDate     DateTime?
  quantityReceived      Decimal
  remainingQuantity     Decimal
  quantityReturned      Decimal                    @default(0)
  purchasePrice         Decimal
  expiryDate            DateTime?
  purchaseInvoiceNumber String?
  notes                 String?
  status                String                     @default("ACTIVE")
  createdAt             DateTime                   @default(now())
  updatedAt             DateTime                   @default(now()) @updatedAt
  sellingPrice          Decimal                    @default(0)
  purchase              Purchase?                  @relation(fields: [purchaseId], references: [id])
  supplier              Supplier?                  @relation(fields: [supplierId], references: [id])
  product               Product                    @relation(fields: [productId], references: [id])
  purchaseItems         PurchaseItem[]
  returnItems           ReturnItem[]
  saleConsumptions      SaleItemBatchConsumption[]
  stockMovements        StockMovement[]
  supplierReturns       SupplierReturn[]

  @@index([productId, status])
  @@index([expiryDate])
  @@index([productId, purchaseDate])
}

model StockMovement {
  id               String        @id @default(cuid())
  productId        String
  batchId          String?
  movementType     String
  quantity         Decimal
  previousQuantity Decimal
  newQuantity      Decimal
  referenceType    String?
  referenceId      String?
  userId           String
  notes            String?
  createdAt        DateTime      @default(now())
  user             User          @relation(fields: [userId], references: [id])
  batch            ProductBatch? @relation(fields: [batchId], references: [id])
  product          Product       @relation(fields: [productId], references: [id])

  @@index([productId, createdAt])
  @@index([referenceType, referenceId])
}

model Supplier {
  id               String            @id @default(cuid())
  name             String
  company          String?
  phone            String
  email            String?
  address          String?
  notes            String?
  status           String            @default("ACTIVE")
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt
  products         Product[]
  batches          ProductBatch[]
  purchases        Purchase[]
  supplierPayments SupplierPayment[]
  supplierReturns  SupplierReturn[]

  @@index([name])
  @@index([phone])
}

model Purchase {
  id              String            @id @default(cuid())
  purchaseNumber  String            @unique
  supplierId      String
  invoiceNumber   String?
  purchaseDate    DateTime          @default(now())
  totalAmount     Decimal
  paidAmount      Decimal           @default(0)
  dueAmount       Decimal           @default(0)
  paymentStatus   String            @default("DUE")
  status          String            @default("COMPLETED")
  voidReason      String?
  createdById     String
  createdAt       DateTime          @default(now())
  batches         ProductBatch[]
  createdBy       User              @relation("PurchaseCreatedBy", fields: [createdById], references: [id])
  supplier        Supplier          @relation(fields: [supplierId], references: [id])
  items           PurchaseItem[]
  payments        SupplierPayment[]
  supplierReturns SupplierReturn[]

  @@index([supplierId])
  @@index([purchaseDate])
}

model PurchaseItem {
  id         String        @id @default(cuid())
  purchaseId String
  productId  String
  batchId    String?
  quantity   Decimal
  unitCost   Decimal
  total      Decimal
  batch      ProductBatch? @relation(fields: [batchId], references: [id])
  product    Product       @relation(fields: [productId], references: [id])
  purchase   Purchase      @relation(fields: [purchaseId], references: [id])

  @@index([purchaseId])
}

model SupplierPayment {
  id                   String    @id @default(cuid())
  idempotencyKey        String?   @unique
  paymentNumber        String?   @unique
  supplierId           String
  purchaseId           String?
  amount               Decimal
  paymentDate          DateTime  @default(now())
  method               String
  reference            String?
  notes                String?
  previousOutstanding  Decimal?
  remainingOutstanding Decimal?
  createdById          String
  createdAt            DateTime  @default(now())
  createdBy            User      @relation(fields: [createdById], references: [id])
  purchase             Purchase? @relation(fields: [purchaseId], references: [id])
  supplier             Supplier  @relation(fields: [supplierId], references: [id])

  @@index([supplierId])
}

model SupplierReturn {
  id             String       @id @default(cuid())
  returnNumber   String       @unique
  supplierId     String
  purchaseId     String
  productId      String
  batchId        String
  quantity       Decimal
  unitCost       Decimal
  returnValue    Decimal
  returnDate     DateTime     @default(now())
  reason         String
  notes          String?
  settlementType String       @default("CREDIT")
  status         String       @default("COMPLETED")
  cancelReason   String?
  createdById    String
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
  createdBy      User         @relation("SupplierReturnCreatedBy", fields: [createdById], references: [id])
  batch          ProductBatch @relation(fields: [batchId], references: [id])
  product        Product      @relation(fields: [productId], references: [id])
  purchase       Purchase     @relation(fields: [purchaseId], references: [id])
  supplier       Supplier     @relation(fields: [supplierId], references: [id])

  @@index([supplierId])
  @@index([purchaseId])
  @@index([batchId])
}

model Customer {
  id               String            @id @default(cuid())
  name             String
  phone            String?           @unique
  address          String?
  status           String            @default("ACTIVE")
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt
  customerPayments CustomerPayment[]
  membership       Membership?
  returns          Return[]
  sales            Sale[]

  @@index([name])
  @@index([phone])
}

model CustomerPayment {
  id          String   @id @default(cuid())
  customerId  String
  saleId      String?
  amount      Decimal
  paymentDate DateTime @default(now())
  method      String
  reference   String?
  createdById String
  createdAt   DateTime @default(now())
  createdBy   User     @relation(fields: [createdById], references: [id])
  sale        Sale?    @relation(fields: [saleId], references: [id])
  customer    Customer @relation(fields: [customerId], references: [id])

  @@index([customerId])
}

model Membership {
  id               String    @id @default(cuid())
  membershipNumber String    @unique
  customerId       String    @unique
  tier             String    @default("STANDARD")
  issueDate        DateTime  @default(now())
  expiryDate       DateTime?
  status           String    @default("ACTIVE")
  qrCodeData       String
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt
  customer         Customer  @relation(fields: [customerId], references: [id])
}

model Sale {
  id                String            @id @default(cuid())
  saleNumber        String            @unique
  customerId        String?
  saleDate          DateTime          @default(now())
  subtotal          Decimal
  discount          Decimal           @default(0)
  totalAmount       Decimal
  cogsAmount        Decimal           @default(0)
  paymentMethod     String
  paymentStatus     String            @default("PAID")
  status            String            @default("COMPLETED")
  voidReason        String?
  codCollectedAt    DateTime?
  codCollectedById  String?
  onlineOrderNumber String?
  createdById       String
  createdAt         DateTime          @default(now())
  customerPayments  CustomerPayment[]
  returns           Return[]
  createdBy         User              @relation("SaleCreatedBy", fields: [createdById], references: [id])
  codCollectedBy    User?             @relation("SaleCodCollectedBy", fields: [codCollectedById], references: [id])
  customer          Customer?         @relation(fields: [customerId], references: [id])
  items             SaleItem[]

  @@index([saleDate])
  @@index([customerId])
  @@index([paymentStatus])
}

model SaleItem {
  id                String                     @id @default(cuid())
  saleId            String
  productId         String
  quantity          Decimal
  unitPrice         Decimal
  discount          Decimal                    @default(0)
  subtotal          Decimal
  cogsTotal         Decimal                    @default(0)
  returnItems       ReturnItem[]
  product           Product                    @relation(fields: [productId], references: [id])
  sale              Sale                       @relation(fields: [saleId], references: [id])
  batchConsumptions SaleItemBatchConsumption[]

  @@index([saleId])
}

model SaleItemBatchConsumption {
  id               String       @id @default(cuid())
  saleItemId       String
  batchId          String
  quantityConsumed Decimal
  unitCost         Decimal
  batch            ProductBatch @relation(fields: [batchId], references: [id])
  saleItem         SaleItem     @relation(fields: [saleItemId], references: [id])

  @@index([saleItemId])
}

model Return {
  id           String       @id @default(cuid())
  returnNumber String       @unique
  saleId       String
  customerId   String?
  returnDate   DateTime     @default(now())
  totalRefund  Decimal
  reason       String?
  createdById  String
  createdAt    DateTime     @default(now())
  createdBy    User         @relation(fields: [createdById], references: [id])
  customer     Customer?    @relation(fields: [customerId], references: [id])
  sale         Sale         @relation(fields: [saleId], references: [id])
  items        ReturnItem[]

  @@index([saleId])
}

model ReturnItem {
  id            String        @id @default(cuid())
  returnId      String
  saleItemId    String
  productId     String
  quantity      Decimal
  condition     String
  refundAmount  Decimal
  targetBatchId String?
  targetBatch   ProductBatch? @relation(fields: [targetBatchId], references: [id])
  product       Product       @relation(fields: [productId], references: [id])
  saleItem      SaleItem      @relation(fields: [saleItemId], references: [id])
  return        Return        @relation(fields: [returnId], references: [id])

  @@index([returnId])
}

model Employee {
  id          String   @id @default(cuid())
  name        String
  phone       String
  address     String?
  position    String
  joiningDate DateTime @default(now())
  baseSalary  Decimal
  status      String   @default("ACTIVE")
  notes       String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  salaries    Salary[]
}

model Salary {
  id            String    @id @default(cuid())
  employeeId    String
  salaryMonth   String
  baseSalary    Decimal
  bonus         Decimal   @default(0)
  deduction     Decimal   @default(0)
  netSalary     Decimal
  paymentStatus String    @default("DUE")
  paymentDate   DateTime?
  paymentMethod String?
  reference     String?
  createdById   String
  createdAt     DateTime  @default(now())
  createdBy     User      @relation(fields: [createdById], references: [id])
  employee      Employee  @relation(fields: [employeeId], references: [id])

  @@unique([employeeId, salaryMonth])
}

model ExpenseCategory {
  id         String    @id @default(cuid())
  name       String    @unique
  isArchived Boolean   @default(false)
  expenses   Expense[]
}

model Expense {
  id            String          @id @default(cuid())
  expenseNumber String          @unique
  categoryId    String
  description   String
  amount        Decimal
  expenseDate   DateTime        @default(now())
  paymentMethod String
  reference     String?
  notes         String?
  status        String          @default("RECORDED")
  createdById   String
  createdAt     DateTime        @default(now())
  createdBy     User            @relation(fields: [createdById], references: [id])
  category      ExpenseCategory @relation(fields: [categoryId], references: [id])

  @@index([categoryId])
  @@index([expenseDate])
}

model CashTransaction {
  id              String   @id @default(cuid())
  type            String
  amount          Decimal
  transactionDate DateTime
  note            String?
  createdById     String
  createdAt       DateTime @default(now())
  createdBy       User     @relation(fields: [createdById], references: [id])

  @@index([transactionDate])
  @@index([type, transactionDate])
}

model Notification {
  id                String   @id @default(cuid())
  type              String
  title             String
  message           String
  severity          String   @default("INFO")
  isRead            Boolean  @default(false)
  relatedEntityType String?
  relatedEntityId   String?
  createdAt         DateTime @default(now())

  @@index([isRead, createdAt])
}

model DailyClosing {
  id                 String   @id @default(cuid())
  closingDate        DateTime @unique
  totalSales         Decimal
  cashSales          Decimal
  bkashSales         Decimal
  codCollected       Decimal
  returns            Decimal
  expenses           Decimal
  supplierPayments   Decimal
  customerPayments   Decimal
  cogs               Decimal
  grossProfit        Decimal
  netOperatingResult Decimal
  closedById         String
  createdAt          DateTime @default(now())
  closedBy           User     @relation(fields: [closedById], references: [id])
}

model InvoiceSequence {
  id         String @id @default(cuid())
  prefix     String
  year       Int    @default(0)
  lastNumber Int    @default(0)

  @@unique([prefix, year])
}

model SyncQueue {
  id            String    @id @default(cuid())
  entityType    String
  entityId      String
  operationType String
  payload       String
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  syncStatus    String    @default("PENDING")
  retryCount    Int       @default(0)
  errorMessage  String?
  syncedAt      DateTime?

  @@index([syncStatus])
  @@index([entityType, entityId])
}

model Backup {
  id            String   @id @default(cuid())
  filePath      String
  fileSizeBytes Int
  createdAt     DateTime @default(now())
  createdById   String
  notes         String?
  createdBy     User     @relation(fields: [createdById], references: [id])
}

model BkashTransaction {
  id              String   @id @default(uuid())
  type            String
  amount          Decimal
  transactionDate DateTime @default(now())
  note            String?
  createdById     String
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  createdBy       User     @relation(fields: [createdById], references: [id])
}
