{
  "name": "torki-bazar-retail-management-system",
  "version": "0.1.49",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "build": "npm run build:database && npm run build:core && electron-vite build --config apps/desktop/electron.vite.config.ts",
    "dist:win": "npm run build && electron-builder --config electron-builder.yml --win",
    "build:database": "npm --prefix packages/database run build",
    "build:core": "npm --prefix packages/core run build"
  },
  "dependencies": {
    "@prisma/client": "^5.22.0",
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.6",
    "dotenv": "^17.4.2",
    "electron-updater": "^6.8.9",
    "express": "^5.2.1"
  },
  "devDependencies": {
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/node": "^26.2.0",
    "electron": "^32.3.3",
    "electron-builder": "^26.15.3",
    "typescript": "^5.6.3"
  },
  "main": "out/main/index.js"
}
