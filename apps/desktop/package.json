{
  "name": "@torki-bazar/desktop",
  "version": "0.1.0",
  "private": true,
  "main": "out/main/index.js",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "preview": "electron-vite preview",
    "start": "electron-vite preview",
    "dist:win": "npm run build && electron-builder --win --x64"
  },
  "dependencies": {
    "@torki-bazar/core": "*",
    "@torki-bazar/database": "*",
    "@torki-bazar/shared": "*",
    "electron-updater": "^6.8.9",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.26.2",
    "zustand": "^4.5.5"
  },
  "devDependencies": {
    "@types/react": "^18.3.5",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.3.1",
    "autoprefixer": "^10.4.20",
    "electron": "32.3.3",
    "electron-builder": "^26.15.3",
    "electron-vite": "^2.3.0",
    "postcss": "^8.4.47",
    "tailwindcss": "^3.4.10",
    "typescript": "^5.6.3",
    "vite": "^5.4.6"
  },
  "build": {
    "appId": "com.torkibazar.retail",
    "productName": "Torki Bazar",
    "artifactName": "Torki-Bazar-Setup-${version}.${ext}",
    "asar": true,
    "files": [
      "out/**/*",
      "node_modules/**/*",
      "../../packages/database/prisma/schema.prisma",
      "../../packages/database/prisma/schema.neon.prisma",
      "../../packages/database/prisma/schema.postgres.prisma",
      "../../node_modules/.prisma/client/**/*",
      "../../node_modules/@prisma/client/**/*"
    ],
    "extraResources": [
      {
        "from": "../../node_modules/.prisma/client",
        "to": "prisma-client"
      }
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "artifactName": "Torki-Bazar-Setup-${version}.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Torki Bazar",
      "deleteAppDataOnUninstall": false
    },
    "publish": {
      "provider": "github",
      "owner": "usaibnenuhu",
      "repo": "usaibnenuhu-torki-bazar-app",
      "releaseType": "release"
    },
    "icon": "build/icon.ico"
  }
}
