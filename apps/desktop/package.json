{
  "name": "@torki-bazar/desktop",
  "version": "0.1.42",
  "private": true,
  "main": "out/main/index.js",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "preview": "electron-vite preview",
    "start": "electron-vite preview",
    "dist:win": "electron-vite build && electron-builder --win --x64"
  },
  "dependencies": {
    "@torki-bazar/core": "*",
    "@torki-bazar/database": "*",
    "@torki-bazar/shared": "*",
    "electron-updater": "^6.6.2",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.26.2",
    "zustand": "^4.5.5"
  },
  "devDependencies": {
    "@types/react": "^18.3.5",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.3.1",
    "autoprefixer": "^10.4.20",
    "electron": "32.3.3",
    "electron-vite": "^2.3.0",
    "postcss": "^8.4.47",
    "tailwindcss": "^3.4.10",
    "typescript": "^5.6.3",
    "vite": "^5.4.6"
  },
  "description": "Torki Bazar RMS",
  "author": "Torki Bazar",
  "build": {
    "appId": "com.torkibazar.desktop",
    "productName": "Torki Bazar RMS",
    "artifactName": "Torki-Bazar-RMS-Setup-${version}.${ext}",
    "asar": true,
    "files": [
      "out/**/*",
      "node_modules/**/*",
      "../../packages/database/prisma/schema.prisma",
      "../../packages/database/prisma/schema.neon.prisma",
      "../../packages/database/prisma/schema.postgres.prisma",
      {
        "from": "prisma-client-stage/client",
        "to": "node_modules/.prisma/client"
      },
      {
        "from": "../../packages/database/prisma/generated/neon",
        "to": "node_modules/@torki-bazar/database/prisma/generated/neon"
      }
    ],
    "extraResources": [
      {
        "from": "build/database/torki-bazar-template.db",
        "to": "database/torki-bazar-template.db"
      },
      {
        "from": "build/neon-config.json",
        "to": "neon-config.json"
      },
      {
        "from": "../../packages/database/prisma/generated/sqlite",
        "to": "database/generated/sqlite"
      }
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "executableName": "Torki-Bazar-RMS",
      "artifactName": "Torki-Bazar-RMS-Setup-${version}.${ext}",
      "icon": "build/icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowElevation": true,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": "always",
      "createStartMenuShortcut": true,
      "shortcutName": "Torki Bazar RMS",
      "menuCategory": "Torki Bazar",
      "runAfterFinish": true,
      "deleteAppDataOnUninstall": false
    },
    "publish": {
      "provider": "github",
      "owner": "usaibnenuhu",
      "repo": "usaibnenuhu-torki-bazar-app",
      "releaseType": "release"
    }
  }
}
