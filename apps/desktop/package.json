{
  "name": "@torki-bazar/desktop",
  "version": "0.1.3",
  "private": true,
  "main": "out/main/index.js",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "preview": "electron-vite preview",
    "start": "electron-vite preview",
    "dist:win": "npm run build && electron-builder --win --x64",
    "dist:win:dir": "npm run build && electron-builder --win --x64 --dir"
  },
  "dependencies": {
    "@torki-bazar/core": "*",
    "@torki-bazar/database": "*",
    "@torki-bazar/shared": "*",
    "electron-updater": "^6.8.9",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.26.2",
    "zustand": "^4.5.5"
  },
  "devDependencies": {
    "@types/react": "^18.3.5",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.3.1",
    "autoprefixer": "^10.4.20",
    "electron": "32.3.3",
    "electron-vite": "^2.3.0",
    "postcss": "^8.4.47",
    "tailwindcss": "^3.4.10",
    "typescript": "^5.6.3",
    "vite": "^5.4.6"
  },
  "build": {
    "appId": "com.torkibazar.retailmanagement",
    "productName": "Torki Bazar Retail Management System",
    "artifactName": "Torki-Bazar-Setup-${version}.${ext}",
    "asar": true,
    "compression": "normal",
    "directories": {
      "output": "release"
    },
    "files": [
      "out/**/*",
      "package.json",
      "!node_modules/@prisma/client{,/**/*}",
      "!node_modules/.prisma{,/**/*}"
    ],
    "extraMetadata": {
      "name": "torki-bazar-retail-management-system"
    },
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "executableName": "Torki-Bazar",
      "artifactName": "Torki-Bazar-Setup-${version}.exe",
      "icon": "build/icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Torki Bazar",
      "runAfterFinish": true,
      "include": "build/installer.nsh"
    },
    "publish": {
      "provider": "github",
      "owner": "usaibnenuhu",
      "repo": "usaibnenuhu-torki-bazar-app",
      "releaseType": "release"
    },
    "asarUnpack": [
      "node_modules/@torki-bazar/database/prisma/generated/neon/**/*"
    ],
    "extraResources": [
      {
        "from": "node_modules/@prisma/client",
        "to": "node_modules/@prisma/client"
      },
      {
        "from": "node_modules/.prisma",
        "to": "node_modules/.prisma"
      },
      {
        "from": "build/database/torki-bazar-template.db",
        "to": "database/torki-bazar-template.db"
      }
    ]
  },
  "description": "Torki Bazar Retail Management System",
  "author": "Nuhu"
}
